//used for cross languge compatibility, pydanti aur typedict se nhi krr skte usme

{
    "title": "LangChain Components Outputs",
    "description": "This JSON schema defines the structure of the outputs generated by LangChain components.",
    "type": "object",
    "properties": {
        "output": {
            "type": "string",
            "description": "The output generated by the LangChain component."
        },
        "metadata": {
            "type": "object",
            "description": "Additional metadata related to the output.",
            "properties": {
                "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the output was generated."
                },
                "source": {
                    "type": "string",
                    "description": "The source or origin of the output."
                }
            },
            "required": ["timestamp", "source"]
        }
    }

}